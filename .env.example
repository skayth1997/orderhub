# Where the apps run
ORDERHUB_PORT=3000
INVENTORY_PORT=3001
NOTIFICATIONS_PORT=3002

# Security
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
RATE_LIMIT_PER_MINUTE=300

# Orders database (PostgreSQL)
DB_HOST=localhost
DB_PORT=54320
DB_USER=orderhub
DB_PASSWORD=orderhub
DB_NAME=orderhub

# Inventory database (PostgreSQL)
INVENTORY_DB_HOST=localhost
INVENTORY_DB_PORT=54321
INVENTORY_DB_USER=inventory
INVENTORY_DB_PASSWORD=inventory
INVENTORY_DB_NAME=inventory

# Kafka
KAFKA_BROKERS=localhost:9092

# Inventory consumer: wait times (ms) before each retry, then it gives up
INVENTORY_RETRY_DELAYS_MS=1000,5000,15000

# Redis (stock cache and rate limit)
REDIS_HOST=localhost
REDIS_PORT=6379
STOCK_CACHE_SECONDS=30

# MongoDB (notifications)
MONGO_PORT=27017
MONGO_URL=mongodb://localhost:27017/notifications

# RabbitMQ (email jobs)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=orderhub
RABBITMQ_PASSWORD=orderhub

# SQS on LocalStack (SMS jobs). The keys are fake, LocalStack accepts anything.
LOCALSTACK_PORT=4566
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Log in with Google (see the README for how to create these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Database web tools
ADMINER_PORT=8081
MONGO_EXPRESS_PORT=8082
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin
REDISINSIGHT_PORT=5540
